---
import Layout from "../../layouts/Layout.astro"
import logo from "../../assets/logo.svg"
import graduateLogin from "../../assets/graduate-login.webp"
import LoginForm from "../../components/LoginForm.astro"
import LayoutAuth from "../../layouts/LayoutAuth.astro"
---

<LayoutAuth title="Ingresa al sistema como egresado">
  <div class="min-h-dvh flex items-center justify-center">
    <div
      class="w-full max-w-4xl rounded-xl overflow-hidden grid grid-cols-2 shadow-2xl relative"
    >
      <a
        href="/auth"
        class="absolute top-3 right-3 text-sm inline-flex items-center text-neutral-700 hover:text-blue-400 transition"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M5 12l14 0"></path><path d="M5 12l4 4"></path><path
            d="M5 12l4 -4"></path></svg
        >
        Volver
      </a>
      <div
        class="flex justify-center items-center bg-gradient-to-tl to-blue-500 from-blue-800"
      >
        <img src={graduateLogin.src} class="drop-shadow-2xl w-80" alt="" />
      </div>
      <section class="bg-white px-10 py-8">
        <img
          src={logo.src}
          alt="Logotipo de UTP+trace"
          class="w-auto mx-auto mb-4 h-8"
          transition:name="logo-utp-trace"
        />
        <h2 class="font-bold text-center">¡Bienvenido👋!</h2>
        <p class="text-center text-neutral-800 mb-3">
          Ingresa tus datos para <strong>iniciar sesión.</strong>
        </p>
        <LoginForm userType="GRADUATE" />
      </section>
    </div>
  </div>
</LayoutAuth>
